# suyuan L0 存活探针配置模板
# 复制为 /opt/suyuan-monitor/l0_probe.env 并按部署机实际情况修改。
# 已导出的同名 L0_* 环境变量优先于本文件（systemd 覆盖测试用）。

# 探活目标：name|url 逗号分隔。
# 本机双项目布局（见 AGENTS.md）：main 8000/8011 + 江苏运维 8001/8012 + 共享嵌入服务 8020。
# 若某部署机没有某项（如未部署嵌入服务或只跑一个项目），删除对应条目即可。
L0_TARGETS=main-web|http://127.0.0.1:8000/health,main-worker|http://127.0.0.1:8011/health,main-embedding|http://127.0.0.1:8020/health,jiangsu-web|http://127.0.0.1:8001/health,jiangsu-worker|http://127.0.0.1:8012/health

# 带外告警通道：不经过 suyuan 后端的 webhook。
# channel 取值：wecom（企业微信群机器人）/ feishu（飞书群机器人）/ dingtalk（钉钉群机器人）/ generic（通用 JSON POST）
# 未配置 URL 时探针仍可运行，异常只记入日志（journal），便于通道就绪前先部署探针。
L0_WEBHOOK_URL=
L0_WEBHOOK_CHANNEL=wecom

# 单目标探测超时（秒）
L0_TIMEOUT_SECONDS=5

# 持续宕机时的重报间隔（分钟），默认 360 = 6 小时一次，防轰炸
L0_ALERT_REPEAT_MINUTES=360

# 状态文件位置（记录每个目标的上下线状态与告警时间）
L0_STATE_FILE=/var/lib/suyuan-l0-probe/state.json
