# suyuan 维护守护进程配置模板
# 复制为 maintenance.env 并按部署环境修改。MAINTENANCE_TOKEN 必须设置，
# 守护进程拒绝以空 token 启动（不设防=把容器栈裸交给 AI）。

# 共享 token：与应用侧 backend/.env 的 MAINTENANCE_DAEMON_TOKEN 保持一致
MAINTENANCE_TOKEN=change-me-to-a-long-random-string

# 宿主机上的仓库根（git 快照/回滚在此执行）
MAINTENANCE_REPO_ROOT=C:/Users/ZSC/.zcode/workspace/default/suyuan-main-work

# ---- 重启方式二选一 ----
# 方式 A（本地 Docker 部署）：compose 项目与编排文件
MAINTENANCE_COMPOSE_PROJECT=suyuan-dev
MAINTENANCE_COMPOSE_FILE=C:/Users/ZSC/.zcode/workspace/default/suyuan-main-work/deploy/local/docker-compose.dev.yml

# 方式 B（服务器原生部署）：重启脚本（设置后忽略 compose 参数）
# MAINTENANCE_RESTART_COMMAND=/home/xckj/suyuan-main/backend/restart_server.sh

# ---- 健康探针（service 名 → URL，容器经 host.docker.internal 访问宿主端口）----
MAINTENANCE_HEALTH_web=http://127.0.0.1:18000/health
MAINTENANCE_HEALTH_worker=http://127.0.0.1:18011/health

# 监听端口（默认 8013，仅 127.0.0.1；容器侧 URL 填 http://host.docker.internal:8013）
MAINTENANCE_PORT=8013
