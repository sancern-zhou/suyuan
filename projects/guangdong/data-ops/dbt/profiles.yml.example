# 复制为 profiles.yml 并填入真实密码（profiles.yml 已 gitignore，不进仓库）
# dbt 通过 --profiles-dir 指向本目录（sync-all/sync-daily 计划任务 / 手工 dbt build 均在工作目录解析）
# 库名按部署环境填写（本机为 suyuan_app，与 OPS_MART_DATABASE_URL 同库）
guangdong_marts:
  target: prod
  outputs:
    prod:
      type: postgres
      host: 127.0.0.1
      port: 5433
      user: suyuan
      password: "<suyuan 用户密码>"
      dbname: suyuan_app
      schema: guangdong_mart
      threads: 4
