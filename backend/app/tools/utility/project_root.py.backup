"""
项目工作区根目录解析

提供稳定的项目根目录定位，替代 Path.cwd() 方式。
从当前文件位置向上查找 .git 目录来定位项目根，避免受运行时 cwd 影响。
"""

import os
from pathlib import Path
from typing import Optional

# 模块级缓存，避免重复计算
_project_root: Optional[Path] = None


def get_project_root() -> Path:
    """
    获取项目根目录（稳定路径，不依赖 cwd）

    查找策略：
    1. 环境变量 SUYUAN_PROJECT_ROOT（优先，支持部署时覆盖）
    2. 从当前文件位置向上查找 .git 目录
    3. 兜底使用 Path.cwd()（向后兼容）

    Returns:
        Path: 项目根目录（如 /home/xckj/suyuan）
    """
    global _project_root
    if _project_root is not None:
        return _project_root

    # 策略 1：环境变量
    env_root = os.environ.get("SUYUAN_PROJECT_ROOT")
    if env_root:
        p = Path(env_root).resolve()
        if p.is_dir():
            _project_root = p
            return _project_root

    # 策略 2：从当前文件向上查找 .git
    current = Path(__file__).resolve()
    for parent in current.parents:
        if (parent / ".git").is_dir():
            _project_root = parent
            return _project_root

    # 策略 3：兜底 cwd
    _project_root = Path.cwd()
    return _project_root


def reset_project_root() -> None:
    """重置缓存（仅用于测试）"""
    global _project_root
    _project_root = None
