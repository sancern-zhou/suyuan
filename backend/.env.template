# ============================================
# 数据库配置 (Database Configuration)
# ============================================

# PostgreSQL + TimescaleDB 连接字符串
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 示例: postgresql+asyncpg://postgres:password@localhost:5432/weather_db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/weather_db
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/knowledge_db
KNOWLEDGE_BASE_LOCAL_SCOPE=project-id
WEATHER_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/weather_db
DATABASE_SCHEMA_INIT_ON_STARTUP=false

# 知识库向量存储：共享库使用中心 Qdrant；本地库使用当前项目的独立 Qdrant。
SHARED_QDRANT_HOST=
SHARED_QDRANT_PORT=6333
SHARED_QDRANT_API_KEY=
SHARED_QDRANT_HTTPS=false
SHARED_QDRANT_TIMEOUT=300
LOCAL_QDRANT_HOST=localhost
LOCAL_QDRANT_PORT=6334
LOCAL_QDRANT_API_KEY=
LOCAL_QDRANT_HTTPS=false
LOCAL_QDRANT_TIMEOUT=30

# ============================================
# 外部API配置 (External APIs)
# ============================================

