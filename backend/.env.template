# ============================================
# 数据库配置 (Database Configuration)
# ============================================

# PostgreSQL + TimescaleDB 连接字符串
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 示例: postgresql+asyncpg://postgres:password@localhost:5432/weather_db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/weather_db

# ============================================
# 外部API配置 (External APIs)
# ============================================

# 站点和行政区查询API
STATION_API_BASE_URL=http://180.184.91.74:9095

# 监测数据查询API
MONITORING_DATA_API_URL=http://180.184.91.74:9091
VOCS_DATA_API_URL=http://180.184.91.74:9092
PARTICULATE_DATA_API_URL=http://180.184.91.74:9093

# 气象数据API
METEOROLOGICAL_API_URL=http://180.184.30.94/api/AiDataService/.../Query
METEOROLOGICAL_API_KEY=1882bb80-16a0-419a-ae3e-f442471909d3

# 上风向分析API
UPWIND_ANALYSIS_API_URL=http://192.168.20.2:9092

# 高德地图API密钥（可选）
AMAP_PUBLIC_KEY=your-amap-key-here

# ============================================
# LLM配置 (LLM Configuration)
# ============================================

# LLM提供商: openai, deepseek, anthropic, minimax, mimo, agnes, qwen, glm
LLM_PROVIDER=deepseek

# DeepSeek配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-reasoner

# 自动模式按 LLM_PROVIDER 优先，再按 LLM_FALLBACKS 回退。
# Flash/Pro 只选择对应链路，并跳过 GLM。
LLM_FALLBACKS=agnes/agnes-2.0-flash,deepseek/deepseek-chat
LLM_FLASH_MODELS=agnes/agnes-2.0-flash,deepseek/deepseek-chat
LLM_PRO_MODELS=agnes/agnes-2.0-flash,deepseek/deepseek-reasoner
# Auto按明确运行场景profile选择能力链路；当前 social 使用 multimodal。
LLM_MULTIMODAL_MODELS=agnes/agnes-2.0-flash,minimax/MiniMax-M3

# OpenAI配置（可选）
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic配置（可选）
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_AUTH_TOKEN=your-anthropic-compatible-token-here
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=claude-3-opus-20240229

# GLM配置（可选，用作Agent/工具调用模型）
GLM_API_KEY=your-glm-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_MODEL=glm-4.7

# Agnes配置（可选，OpenAI Chat Completions兼容）
AGNES_API_KEY=your-agnes-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_API_MODE=chat_completions

