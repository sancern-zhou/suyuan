STATION_API_BASE_URL=http://180.184.91.74:9095

# 监测数据查询API
MONITORING_DATA_API_URL=http://180.184.91.74:9091
VOCS_DATA_API_URL=http://180.184.91.74:9092
PARTICULATE_DATA_API_URL=http://180.184.91.74:9093

# 气象数据API
METEOROLOGICAL_API_URL=http://180.184.30.94/api/AiDataService/.../Query
METEOROLOGICAL_API_KEY=
DIFY_BASE_URL=
DIFY_API_KEY=
GD_SUNCERE_API_USERNAME=
GD_SUNCERE_API_PASSWORD=

# 上风向分析API
UPWIND_ANALYSIS_API_URL=http://192.168.20.2:9092

# 高德地图API密钥（可选）
AMAP_PUBLIC_KEY=your-amap-key-here

# ============================================
# LLM配置 (LLM Configuration)
# ============================================

# LLM提供商: doubao, openai, deepseek, anthropic, minimax, mimo, agnes, glm, bailian
LLM_PROVIDER=doubao
DOUBAO_API_KEY=your-doubao-key-here
DOUBAO_BASE_URL=https://doubao.best/v1
DOUBAO_MODEL=gpt-5.6-luna
DOUBAO_API_MODE=chat_completions
BAILIAN_API_KEY=your-bailian-token-plan-key-here
BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic
BAILIAN_MODEL=qwen3.8-max-preview
BAILIAN_API_MODE=anthropic_messages

# DeepSeek配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-reasoner

# 自动模式按 LLM_PROVIDER 优先，再按 LLM_FALLBACKS 回退。
# Flash/Pro 只选择对应链路，并跳过 GLM。
LLM_FALLBACKS=doubao/gpt-5.6-luna,agnes/agnes-2.0-flash,deepseek/deepseek-chat
LLM_FLASH_MODELS=doubao/gpt-5.6-luna,bailian/qwen3.6-flash,agnes/agnes-2.0-flash,deepseek/deepseek-chat
LLM_PRO_MODELS=doubao/gpt-5.6-luna,bailian/deepseek-v4-pro,agnes/agnes-2.0-flash,deepseek/deepseek-reasoner
KNOWLEDGE_BASE_LLM_MODEL_TIER=flash
# 知识库 LLM 原文保真分块输出预算（GPT-5.6 Luna 最大输出 128K）
LLM_CHUNK_MAX_OUTPUT_TOKENS=128000

# OpenAI配置（可选）
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic配置（可选）
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_AUTH_TOKEN=your-anthropic-compatible-token-here
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=claude-3-opus-20240229

# GLM配置（可选，用作Agent/工具调用模型）
GLM_API_KEY=your-glm-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_MODEL=glm-4.7

# Agnes配置（可选，OpenAI Chat Completions兼容）
AGNES_API_KEY=your-agnes-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_API_MODE=chat_completions

