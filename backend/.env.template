# 千里马实时检索工具重试最大延迟(秒)
QIANLIMA_REALTIME_MAX_DELAY_SECONDS=30.0

# 千里马实时检索工具请求间延迟(毫秒)
QIANLIMA_REALTIME_REQUEST_DELAY_MS=800

# 千里马实时检索工具详情页最小延迟(秒)
QIANLIMA_REALTIME_DETAIL_MIN_DELAY_SECONDS=1.0

# 千里马实时检索工具详情页最大延迟(秒)
QIANLIMA_REALTIME_DETAIL_MAX_DELAY_SECONDS=3.0

# 千里马实时检索工具最大并发数 (1-5)
QIANLIMA_REALTIME_CONCURRENCY=2

# 千里马实时检索工具启用搜索页延迟
QIANLIMA_REALTIME_ENABLE_SEARCH_DELAY=true

# 千里马实时检索工具启用详情页延迟
QIANLIMA_REALTIME_ENABLE_DETAIL_DELAY=true
