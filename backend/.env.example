# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Company gateway authentication
AUTH_MODE=company
AUTH_SYS_CODE=SUYUAN
AUTH_PLATFORM_SYS_CODE=JCXT
AUTH_SERVICE_URL=http://10.10.204.80:8025/api
AUTH_LOGIN_PATH=/auth/token/authentication
AUTH_CURRENT_USER_PATH=/auth/account/getCurrentUser
AUTH_LOGOUT_PATH=/auth/token/logout
AUTH_ADMIN_ROLE_CODES=
AUTH_IDENTITY_CACHE_TTL_SECONDS=60
AUTH_IDENTITY_CACHE_KEY_PREFIX=suyuan:auth:
AUTH_WS_TICKET_TTL_SECONDS=30
AUTH_SHARE_GRANT_TTL_SECONDS=600
AUTH_DOCS_PUBLIC=false
GATEWAY_API_PREFIX=/api/suyuan
TRUSTED_GATEWAY_NETWORKS=127.0.0.1/32,::1/128,10.10.204.0/24
SIGNED_MEDIA_SECRET=

# Nacos service registration
NACOS_SERVER_ADDRESSES=http://10.10.204.80:8848
NACOS_NAMESPACE=normcraft-ai
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=suyuan-agent
NACOS_CLUSTER_NAME=DEFAULT
NACOS_REGISTER_ENABLED=true
NACOS_INSTANCE_ENABLED=true
NACOS_INSTANCE_IP=127.0.0.1
NACOS_INSTANCE_PORT=8000
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_ACCESS_KEY=
NACOS_SECRET_KEY=

# External API Endpoints
STATION_API_BASE_URL=http://180.184.91.74:9095
MONITORING_DATA_API_URL=http://180.184.91.74:9091
VOCS_DATA_API_URL=http://180.184.91.74:9092
PARTICULATE_DATA_API_URL=http://180.184.91.74:9093
METEOROLOGICAL_API_URL=http://180.184.30.94/api/AiDataService/ReportApplication/UserReportDataQuery/Query
UPWIND_ANALYSIS_API_URL=http://192.168.20.2:9092

# API Keys
METEOROLOGICAL_API_KEY=***REMOVED***
AMAP_PUBLIC_KEY=your_amap_key_here

# LLM Configuration (choose your provider)
# Auto mode uses LLM_PROVIDER first and then LLM_FALLBACKS.
# Flash/Pro mode uses LLM_FLASH_MODELS/LLM_PRO_MODELS and skips GLM.
LLM_PROVIDER=openai  # options: openai, anthropic, deepseek, minimax, mimo, agnes, qwen, glm
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
LLM_GLOBAL_MAX_CONCURRENCY=2
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_FAILOVER_COOLDOWN_SECONDS=60
# Optional comma-separated fallback chain. Each item can be provider or provider/model.
# When only provider is given, that provider's *_MODEL env/config value is used.
LLM_FALLBACKS=agnes/agnes-2.0-flash,minimax/MiniMax-M3,deepseek/deepseek-chat
# Frontend model tier priority chains. Selecting Flash/Pro only chooses one of
# these chains; provider URL/key settings and automatic failover still apply.
LLM_FLASH_MODELS=agnes/agnes-2.0-flash,minimax/MiniMax-M3,deepseek/deepseek-chat
LLM_PRO_MODELS=agnes/agnes-2.0-flash,minimax/MiniMax-M3,deepseek/deepseek-reasoner
# Auto capability profiles. Multimodal is used by runtime scenarios that
# explicitly request multimodal capability, including social mode.
LLM_MULTIMODAL_MODELS=mimo/mimo-v2.5,qwen_vl/qwen3.7-plus

# DeepSeek Configuration (if using)
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_MODE=anthropic_messages

# DeepSeek V4 Flash OpenAI-compatible gateway
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_MODE=chat_completions
# DEEPSEEK_BASE_URL=http://ds.local.ai:30080/compatible-mode/v1
# DEEPSEEK_MODEL=DeepSeek-V4-Flash
# If the gateway requires the service group model id, use:
# DEEPSEEK_MODEL=MDDEEPSEEK25FF2F3E5E17
# DEEPSEEK_API_KEY=api-key

# Anthropic Configuration (if using)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_compatible_token_here
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=claude-3-opus-20240229

# GLM Configuration (if using GLM as Agent/tool-call model)
GLM_API_KEY=your_glm_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_MODEL=glm-4.7

# Xiaomi Mimo Configuration (if using)
MIMO_API_KEY=your_mimo_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5  # options: mimo-v2-flash, mimo-v2.5, mimo-v2.5-pro, mimo-v2-pro, mimo-v2-omni

# Agnes Configuration (OpenAI Chat Completions compatible)
AGNES_API_KEY=your_agnes_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_API_MODE=chat_completions

# Vision/OCR Configuration for ops work-order attachment checks.
QWEN_VL_API_KEY=your_qwen_vl_key_here
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-ocr
QWEN_VISION_MODEL=qwen-vl-max
MIMO_VL_API_KEY=
MIMO_VL_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_VL_MODEL=mimo-v2.5
OPS_AUDIT_FLOW_VISUAL_PROVIDERS=qwen

# Attachment access for /WebFiles/... paths. Configure either a local root or
# a base URL reachable by the vision provider.
OPS_ATTACHMENT_ROOT=
OPS_ATTACHMENT_BASE_URL=http://113.108.142.147:8093

# Redis (for caching and async tasks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
AGENT_STEERING_REDIS_PREFIX=suyuan:agent:steering
AGENT_STEERING_TTL_SECONDS=7200

# Cache TTL (seconds)
CACHE_TTL_CONFIG=3600
CACHE_TTL_ANALYSIS=1800
CACHE_TTL_WEATHER=600

# Analysis Parameters
DEFAULT_SEARCH_RANGE_KM=5
DEFAULT_MAX_ENTERPRISES=30
DEFAULT_TOP_N_ENTERPRISES=8
WIND_SPEED_LOW_THRESHOLD=1.5
CANDIDATE_RADIUS_KM=25
NEARBY_STATIONS_RADIUS_KM=20
NEARBY_STATIONS_MAX_RESULTS=5
SECTOR_HALF_ANGLE=11.25

# Retry Configuration
MAX_RETRIES=3
RETRY_INTERVAL_MS=100
REQUEST_TIMEOUT_SECONDS=30

# ==================== Weather Data Storage Configuration ====================
# PostgreSQL + TimescaleDB Database
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/weather_db
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/weather_db

# ERA5 Reanalysis Data Download
ERA5_DOWNLOAD_ENABLED=true
ERA5_DOWNLOAD_HOUR=2        # Daily download time (2 AM local time)

# Observed Weather Data Download
ENABLE_OBSERVED_DOWNLOAD=true
OBSERVED_DOWNLOAD_HOUR=3    # Daily download time (3 AM local time)

# ==================== Observed Weather Tools Configuration ====================
# WeatherAPI.com API Key (Optional)
# Free tier: 1,000,000 requests/month
# Register at: https://www.weatherapi.com/signup.aspx
# If not configured, system will use Open-Meteo only (10,000 requests/day, no API key required)
WEATHERAPI_KEY=your_weatherapi_key_here
