# ========================================
# 生产环境配置模板
# ========================================
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写所有必需的 API 密钥和配置
# 3. 确保不要将 .env.production 提交到 Git

# Unified Android push (GeTui REST V2)
PUSH_PROVIDER=getui
PUSH_GETUI_APP_ID=replace-with-getui-app-id
PUSH_GETUI_APP_KEY=replace-with-getui-app-key
PUSH_GETUI_MASTER_SECRET=replace-with-getui-master-secret
PUSH_GETUI_BASE_URL=https://restapi.getui.com/v2
PUSH_TIMEOUT_SECONDS=15
PUSH_OFFLINE_TTL_MS=86400000

# ========================================
# LLM Provider Configuration
# ========================================
# 选择一个 LLM 提供商：doubao, minimax, openai, deepseek, anthropic, bailian
LLM_PROVIDER=doubao
DOUBAO_API_KEY=your-doubao-key-here
DOUBAO_BASE_URL=https://doubao.best/v1
DOUBAO_MODEL=gpt-5.6-luna
DOUBAO_API_MODE=chat_completions
BAILIAN_API_KEY=your-bailian-token-plan-key-here
BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic
BAILIAN_MODEL=qwen3.8-max
BAILIAN_API_MODE=anthropic_messages
LLM_FLASH_MODELS=doubao/gpt-5.6-luna,bailian/deepseek-v4-flash-0731,deepseek/deepseek-v4-flash
LLM_PRO_MODELS=bailian/deepseek-v4-pro,deepseek/deepseek-v4-pro
# Knowledge-base faithful chunking output budget (GPT-5.6 Luna max: 128K).
LLM_CHUNK_MAX_OUTPUT_TOKENS=128000

# DeepSeek (推荐：性价比高)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_MODE=chat_completions

# OpenAI (可选)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (可选)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# MiniMax Configuration (if using)
MINIMAX_API_KEY=your-minimax-subscription-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# Optional secondary vision provider for ops work-order attachment checks.
MIMO_VL_API_KEY=
MIMO_VL_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_VL_MODEL=mimo-v2.5
OPS_AUDIT_FLOW_VISUAL_PROVIDERS=bailian

# Attachment access for /WebFiles/... paths. Configure either a local root or
# a public base URL reachable by the vision provider.
OPS_ATTACHMENT_ROOT=
OPS_ATTACHMENT_BASE_URL=http://113.108.142.147:8093

# ========================================
# External API Endpoints
# ========================================
# 站点和区域查询 API
STATION_API_BASE_URL=http://180.184.91.74:9095

# 监测数据 API
MONITORING_DATA_API_URL=http://180.184.91.74:9091
VOCS_DATA_API_URL=http://180.184.91.74:9092
PARTICULATE_DATA_API_URL=http://180.184.91.74:9093

# 气象数据 API
METEOROLOGICAL_API_URL=http://180.184.30.94/api/AiDataService/GetHourWeatherByGeohash/Query
METEOROLOGICAL_API_KEY=
DIFY_BASE_URL=
DIFY_API_KEY=
GD_SUNCERE_API_USERNAME=
GD_SUNCERE_API_PASSWORD=

# 上风向企业分析 API
UPWIND_ANALYSIS_API_URL=http://192.168.20.2:9092

# 高德地图 API Key (可选，用于前端地图显示)
AMAP_PUBLIC_KEY=your-amap-key-here

# ========================================
# Server Configuration
# ========================================
HOST=0.0.0.0
PORT=8000

# CORS 配置 - 修改为你的域名
CORS_ORIGINS=http://your-domain.com,https://your-domain.com,http://localhost:5174

# Company gateway authentication (inject secret values at deployment)
AUTH_MODE=company
AUTH_SYS_CODE=SUYUAN
AUTH_PLATFORM_SYS_CODE=JCXT
AUTH_SERVICE_URL=http://10.10.204.80:8025/api
AUTH_LOGIN_PATH=/auth/token/authentication
AUTH_CURRENT_USER_PATH=/auth/account/getCurrentUser
AUTH_LOGOUT_PATH=/auth/token/logout
AUTH_ADMIN_ROLE_CODES=
AUTH_IDENTITY_CACHE_TTL_SECONDS=60
AUTH_IDENTITY_CACHE_KEY_PREFIX=suyuan:auth:
AUTH_WS_TICKET_TTL_SECONDS=30
AUTH_SHARE_GRANT_TTL_SECONDS=600
AUTH_DOCS_PUBLIC=false
APP_REFRESH_TOKEN_TTL_SECONDS=2592000
COMPANY_OIDC_ISSUER=https://idaut.cnemc.cn
COMPANY_OIDC_AUTHORIZATION_ENDPOINT=https://idaut.cnemc.cn/connect/authorize
COMPANY_OIDC_TOKEN_ENDPOINT=https://idaut.cnemc.cn/connect/token
COMPANY_OIDC_CLIENT_ID=replace-with-idbase-mobile-client-id
COMPANY_OIDC_REDIRECT_URI=com.suyuan.mobile://oauth/callback
COMPANY_OIDC_SCOPES=openid profile roles offline_access
COMPANY_AUTHENTICATION_MORE_URL=https://replace-with-business-host/api/jwt/oauth/authenticationMore
GATEWAY_API_PREFIX=/api/suyuan
TRUSTED_GATEWAY_NETWORKS=10.10.204.0/24
SHARE_SIGNING_SECRET=

# Nacos service registration
NACOS_SERVER_ADDRESSES=http://10.10.204.80:8848
NACOS_NAMESPACE=normcraft-ai
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=suyuan-agent
NACOS_CLUSTER_NAME=DEFAULT
NACOS_REGISTER_ENABLED=true
NACOS_INSTANCE_ENABLED=true
NACOS_INSTANCE_IP=127.0.0.1
NACOS_INSTANCE_PORT=8000
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_ACCESS_KEY=
NACOS_SECRET_KEY=

# ========================================
# Redis Cache Configuration
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password  # 如果启用了密码认证

# 缓存 TTL (秒)
CACHE_TTL=3600
STATION_CACHE_TTL=86400
CONFIG_CACHE_TTL=3600

# ========================================
# Analysis Parameters
# ========================================
DEFAULT_SEARCH_RANGE_KM=5.0
DEFAULT_MAX_ENTERPRISES=30
DEFAULT_TOP_N_ENTERPRISES=8

# ========================================
# HTTP Request Settings
# ========================================
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Cross-knowledge-base global reranking. Set backend=local only to load local weights.
KNOWLEDGE_RERANK_BACKEND=remote
KNOWLEDGE_RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# Dedicated DashScope model-service key; the Bailian Token Plan key is not compatible.
KNOWLEDGE_RERANK_API_KEY=
KNOWLEDGE_RERANK_MODEL=qwen3-rerank
KNOWLEDGE_RERANK_TIMEOUT_SECONDS=8

# ========================================
# Application Settings
# ========================================
DEBUG=False
LOG_LEVEL=INFO

# ========================================
# Database (如果使用)
# ========================================
DATABASE_URL=
LOCAL_DATABASE_URL=
SESSION_DATABASE_URL=
DATABASE_SCHEMA_INIT_ON_STARTUP=false

# Knowledge-base vector stores. Do not point LOCAL_QDRANT_* at SHARED_QDRANT_*.
SHARED_QDRANT_HOST=
SHARED_QDRANT_PORT=6333
SHARED_QDRANT_API_KEY=
SHARED_QDRANT_HTTPS=false
SHARED_QDRANT_TIMEOUT=300
LOCAL_QDRANT_HOST=localhost
LOCAL_QDRANT_PORT=6334
LOCAL_QDRANT_API_KEY=
LOCAL_QDRANT_HTTPS=false
LOCAL_QDRANT_TIMEOUT=30

# SQL Server 配置
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
